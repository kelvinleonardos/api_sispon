  metode_pembayaran            data_tagihan_santri_metode_pembayaran?
  keterangan                   String?                                @db.Text
  nomor_referensi              String?                                @db.VarChar(100)
  id_status                    Int?
  created_at                   DateTime                               @default(now()) @db.Timestamp(0)
  updated_at                   DateTime?                              @db.Timestamp(0)
  created_by                   String?                                @db.VarChar(100)
  updated_by                   String?                                @db.VarChar(100)
  ref_master_jenis_pendapatan  ref_master_kategori                    @relation("JenisRelation", fields: [id_jenis], references: [id], onUpdate: Restrict)
  ref_master_status_pendapatan ref_master_kategori?                   @relation("StatusRelation", fields: [id_status], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([id_jenis], map: "data_pendapatan_lain_id_jenis_fkey")
  @@index([id_status], map: "data_pendapatan_lain_id_status_fkey")
}

model ref_jenis_rapor {
  id        Int     @id @default(autoincrement())
  nama      String  @db.VarChar(100)
  singkatan String  @db.VarChar(10)
  deskripsi String? @db.Text
  is_locked Boolean @default(false)
}

model ref_tanggal_rapor {
  id              Int         @id @default(autoincrement())
  id_jenjang      Int
  tanggal_mid     DateTime    @db.Date
  tanggal_akhir   DateTime    @db.Date
  tanggal_biodata DateTime    @db.Date
  tempat_biodata  String      @db.VarChar(100)
  nama_kepsek     String      @db.VarChar(100)
  niy_kepsek      String      @db.VarChar(35)
  foto_ttd        String?     @default("") @db.Text
  ref_jenjang     ref_jenjang @relation(fields: [id_jenjang], references: [id], onUpdate: Restrict, map: "ref_tanggal_rapor_ibfk_1")

  @@index([id_jenjang], map: "ref_tanggal_rapor_ibfk_1")
}

